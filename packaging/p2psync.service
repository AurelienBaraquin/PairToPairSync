# Linux (systemd, per user):
#   mkdir -p ~/.config/systemd/user && cp p2psync.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now p2psync
#   loginctl enable-linger $USER     # optional: keep running without an open session
[Unit]
Description=PairToPairSync folder synchronisation
After=network-online.target

[Service]
ExecStart=%h/.local/bin/p2psync run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
